{
  "name": "ai-youtube-employee",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname localhost",
    "dev:all": "concurrently --kill-others-on-fail --names app,worker,yt --prefix-colors blue,magenta,green \"npm:dev\" \"npm:worker\" \"npm:worker:yt\"",
    "worker": "uv run --directory media-worker python -m media_worker",
    "worker:setup": "uv sync --directory media-worker",
    "worker:yt": "tsx --conditions=react-server --env-file-if-exists=.env src/worker/index.ts",
    "worker:yt:prod": "tsx --conditions=react-server --env-file-if-exists=.env src/worker/index.ts --production",
    "worker:test": "uv run --directory media-worker pytest -q",
    "worker:lint": "uv run --directory media-worker ruff check . && uv run --directory media-worker ruff format --check .",
    "build": "next build",
    "start": "next start --hostname localhost",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test",
    "setup:env": "node scripts/create-env.mjs",
    "db:migrate": "prisma migrate dev",
    "postdb:migrate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "auth:reset-password": "tsx scripts/reset-password.ts",
    "postinstall": "prisma generate",
    "start:all": "concurrently --kill-others-on-fail --names app,worker,yt --prefix-colors blue,magenta,green \"npm:start\" \"npm:worker\" \"npm:worker:yt:prod\"",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "check:secrets": "node scripts/check-secrets.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.7",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "dotenv": "18.0.7",
    "geist": "1.7.2",
    "lucide-react": "1.56.0",
    "next": "16.4.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.10",
    "prisma": "7.10.0",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "overrides": {
    "mysql2": "3.24.6"
  }
}
