# =====================================================================
# AI YouTube Employee — environment template
# Copy to `.env` and fill in values. NEVER commit `.env`.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Variables are grouped by the phase that first needs them.
# =====================================================================

# --- Core app (Phase 2) ----------------------------------------------
# Display name in the UI and on the Google consent screen (must not contain "YouTube").
NEXT_PUBLIC_APP_NAME="Creator Studio Assistant"
# SQLite database file (the data/ folder is git-ignored). Relative paths start at the project folder.
DATABASE_URL="file:./data/app.db"
# Better Auth: 32+ random bytes (base64). Changing it logs everyone out.
BETTER_AUTH_SECRET=""
# Base URL of the app. Keep "localhost" (not 127.0.0.1) so cookies and the OAuth redirect match.
BETTER_AUTH_URL="http://localhost:3000"
# debug | info | warn | error
LOG_LEVEL="info"

# --- Storage & media (Phase 3) ----------------------------------------
# Where videos, renders and caches are stored (git-ignored). Relative to the repo root or absolute.
STORAGE_DIR="./storage"
MAX_UPLOAD_MB="4096"
MAX_VIDEO_DURATION_MIN="180"
# Leave empty to use ffmpeg/ffprobe from PATH. Windows example: C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=""
FFPROBE_PATH=""

# --- Workers (Phase 3) ------------------------------------------------
# Shared secret for the internal worker API: 32+ random bytes (base64).
WORKER_SHARED_SECRET=""
# URL the workers use to reach the app.
APP_INTERNAL_URL="http://localhost:3000"
# How often an idle worker asks for new jobs (at least 250).
WORKER_POLL_INTERVAL_MS="2000"
# Housekeeping (run by the YouTube/Node worker): how often unused files are removed, in minutes, and how
# many days a stock clip that no scene uses stays cached.
MAINTENANCE_INTERVAL_MIN="60"
STOCK_CACHE_DAYS="14"

# --- Transcription (Phase 4) -------------------------------------------
# Speech-to-text runs locally. Only provider so far: faster-whisper.
TRANSCRIPTION_PROVIDER="faster-whisper"
# tiny | base | small | medium | large-v3 — bigger is more accurate but slower.
# On an old 2-core CPU "base" runs at about 2x real time (a 1-hour video takes ~30 minutes).
WHISPER_MODEL="base"
# auto | cpu | cuda
WHISPER_DEVICE="auto"
# int8 (CPU-friendly) | float16 (NVIDIA GPU)
WHISPER_COMPUTE_TYPE="int8"
# Where speech models are downloaded (git-ignored).
WHISPER_MODELS_DIR="./models/whisper"
# Keep the speech model in memory between transcriptions. "false" frees the RAM after each video
# (recommended on computers with 8 GB or less).
WHISPER_KEEP_LOADED="false"

# --- AI Clip Finder (Phase 4) -----------------------------------------
# Clip length range in seconds (Shorts can be up to 180).
CLIP_MIN_SEC="15"
CLIP_MAX_SEC="60"
# Suggestions kept per video.
CLIP_MAX_SUGGESTIONS="10"
# How many candidate moments the AI rates per video, and how many per request.
# Fewer = faster on slow computers. 1 per request keeps small local models from mixing excerpts up.
CLIP_AI_CANDIDATES="12"
CLIP_AI_BATCH_SIZE="1"
# AI packaging (Phase 6): transcripts longer than this many words are summarised part by part first,
# so they fit small local models (about 2,000 tokens). Raise it for models with a bigger context.
PACKAGING_MAX_INPUT_WORDS="1500"
# Seconds to wait for one AI reply before giving up.
LLM_TIMEOUT_SEC="600"
# Pick the provider in Settings › AI & processing. Configure the ones you want to use below.

# --- AI provider: Ollama (local, free, private — the default) ------------
OLLAMA_BASE_URL="http://127.0.0.1:11434"
# Must be downloaded first: `ollama pull <model>`. Suggestions: qwen2.5:1.5b (4-8 GB RAM),
# qwen2.5:3b or llama3.2:3b (8 GB+), llama3.1:8b (16 GB+). Bigger models judge clips better.
OLLAMA_MODEL="qwen2.5:1.5b"
# Context window for the model (tokens).
OLLAMA_NUM_CTX="4096"
# Longest AI reply in tokens. Stops a small model that keeps generating (and would hit LLM_TIMEOUT_SEC).
OLLAMA_NUM_PREDICT="1024"

# --- AI provider: Google Gemini API (optional, free tier) -------------
# Create a free key at https://aistudio.google.com/app/apikey. Transcript excerpts are sent to Google;
# on the free tier Google may use them to improve its products. Limits can change.
GEMINI_API_KEY=""
# A model listed in AI Studio, e.g. a current "Flash" model.
GEMINI_MODEL=""

# --- AI provider: OpenAI-compatible server (optional) -----------------
# Any /v1/chat/completions server, e.g. LM Studio or llama.cpp on this computer:
# OPENAI_COMPAT_BASE_URL="http://127.0.0.1:1234/v1". Don't point it at a paid service without deciding to.
OPENAI_COMPAT_BASE_URL=""
OPENAI_COMPAT_API_KEY=""
OPENAI_COMPAT_MODEL=""

# --- Shorts editor (Phase 5) -------------------------------------------
# Auto framing uses OpenCV's YuNet face detector (~230 KB, MIT licence). The worker downloads it once from
# the OpenCV Zoo on GitHub into this folder and checks its SHA-256; Centre/Blur/Manual framing need no model.
FACE_MODELS_DIR="./models/face"
# Threads for all video work (processing, Shorts exports, generated videos) and speech recognition.
# 0 = all cores (fastest). On a slow PC, 1 keeps the computer responsive, at the cost of slower jobs.
RENDER_THREADS="0"

# --- YouTube / Google OAuth (Phase 7) ---------------------------------
# From Google Cloud Console > APIs & Services > Credentials (OAuth client: Web application).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/youtube/oauth/callback"
# AES-256-GCM key for OAuth tokens: exactly 32 random bytes, base64. Losing it means reconnecting channels.
TOKEN_ENCRYPTION_KEY=""
# Set to "true" only after your Google Cloud project passes the YouTube API compliance audit.
# While false, uploads are private-only and scheduling is disabled (README › Google Cloud setup).
YOUTUBE_API_AUDITED="false"
# Your project's daily YouTube quota (Google Cloud Console › APIs › YouTube Data API v3 › Quotas).
# The app stops before using it up. Defaults are Google's: 10,000 units and 100 uploads per day.
YOUTUBE_DAILY_UNITS="10000"
YOUTUBE_DAILY_UPLOADS="100"
# Size of each upload piece in KB (multiple of 256). Smaller pieces lose less on a flaky connection.
YOUTUBE_UPLOAD_CHUNK_KB="8192"

# --- Original video generator (Phase 9) -------------------------------
# Stock footage is optional: without a key, scenes use your library videos or uploaded clips.
# Free key: https://www.pexels.com/api/ (200 requests/hour, 20,000/month; the app credits creators).
PEXELS_API_KEY=""
# Optional free key: https://pixabay.com/api/docs/ (100 requests/minute; searches cached 24 h).
PIXABAY_API_KEY=""
# Narration engine: "sapi" = Windows' built-in voices (default, free, offline);
# "kokoro" = optional local model, install first: uv pip install --python media-worker/.venv kokoro soundfile
TTS_PROVIDER="sapi"
# Default voice. Empty = the engine's default. Windows voice names look like "Microsoft Zira Desktop";
# Kokoro voice ids like "af_heart". A Windows voice that isn't installed falls back to the default.
TTS_VOICE=""
